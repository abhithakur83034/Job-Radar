# Environment: development | production | test
NODE_ENV=development
PORT=4000

# MongoDB Connection
# For Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/job_radar
# For MongoDB Atlas (Production & Live):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/job_radar?retryWrites=true&w=majority

# Frontend URL(s) for CORS & redirects (comma-separated for multiple domains, e.g. local + Vercel)
# Local: http://localhost:3000
# Live: https://your-jobradar-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Authentication & Sessions
SESSION_COOKIE_NAME=jr_session
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-bytes-long-for-jobradar
JWT_EXPIRES_IN=7d

# Production Cookie Security
# In local dev: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# In production with separate domains (e.g. Vercel + Render):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
