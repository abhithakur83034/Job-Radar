# Environment: development | production | test
NODE_ENV=development
PORT=4000

# MongoDB Connection
# For Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/job_radar
# For MongoDB Atlas (Production & Live):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/job_radar?retryWrites=true&w=majority

# Frontend URL(s) allowed by CORS (comma-separated for multiple domains)
# Live (set on Render): https://job-radar-lime.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Authentication & Sessions
SESSION_COOKIE_NAME=jr_session
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-bytes-long-for-jobradar
JWT_EXPIRES_IN=7d

# Cookie security. Live (set on Render): COOKIE_SECURE=true, COOKIE_SAME_SITE=lax
# (lax works because the browser reaches the API through the Vercel proxy, same site)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Gmail job-alert import (optional; disabled unless all four are set)
# OAuth client from Google Cloud Console → APIs & Services → Credentials (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must go through the frontend domain so the session cookie is sent:
# Local: http://localhost:3000/api/v1/gmail/callback
# Live (set on Render): https://job-radar-lime.vercel.app/api/v1/gmail/callback
GOOGLE_REDIRECT_URI=
# Encrypts stored Gmail tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=

# --- Job sources (background refresh) ---
# Keyless sources (Remotive, Remote OK, Jobicy, The Muse) work without configuration.
# Keyed sources stay disabled until their credentials are set. Never commit real keys.
# Adzuna: https://developer.adzuna.com (label listings "Adzuna", link to the Adzuna page)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble: request a key at https://in.jooble.org/api/about (free key = 500 requests LIFETIME)
JOOBLE_API_KEY=
JOOBLE_HOST=in.jooble.org
# The Muse: optional free key raises the limit from 500 to 3600 requests/hour
THE_MUSE_API_KEY=

# Background refresh: off by default (and always off in tests)
JOB_REFRESH_ENABLED=false
# How often to check sources (incl. users' company boards); each source's own minimum interval still applies
JOB_REFRESH_INTERVAL_MINUTES=60
JOB_FETCH_TIMEOUT_MS=12000
JOB_FETCH_CONCURRENCY=3
JOB_FETCH_MAX_RETRIES=2
# Employer-board jobs missing from a successful scan for this many days are marked closed
JOB_STALE_GRACE_DAYS=1
# Jobs from feeds that can't report closures (Remotive, Remote OK, The Muse, Adzuna, Jooble,
# email alerts) are hidden after this many days. Jobicy closures come from its status API.
JOB_LISTING_MAX_AGE_DAYS=30
