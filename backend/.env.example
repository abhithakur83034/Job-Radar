# Environment: development | production | test
NODE_ENV=development
PORT=4000

# MongoDB Connection
# For Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/job_radar
# For MongoDB Atlas (Production & Live):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/job_radar?retryWrites=true&w=majority

# Frontend URL(s) allowed by CORS (comma-separated for multiple domains)
# Live (set on Render): https://job-radar-lime.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Authentication & Sessions
SESSION_COOKIE_NAME=jr_session
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-bytes-long-for-jobradar
JWT_EXPIRES_IN=7d

# Cookie security. Live (set on Render): COOKIE_SECURE=true, COOKIE_SAME_SITE=lax
# (lax works because the browser reaches the API through the Vercel proxy, same site)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Gmail job-alert import (optional; disabled unless all four are set)
# OAuth client from Google Cloud Console → APIs & Services → Credentials (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must go through the frontend domain so the session cookie is sent:
# Local: http://localhost:3000/api/v1/gmail/callback
# Live (set on Render): https://job-radar-lime.vercel.app/api/v1/gmail/callback
GOOGLE_REDIRECT_URI=
# Encrypts stored Gmail tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
