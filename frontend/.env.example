# Database — defaults to a local SQLite file so the app runs with zero setup.
# For production, point this at a free Supabase/Neon Postgres project instead
# and switch the provider in prisma/schema.prisma from "sqlite" to "postgresql"
# (see README "Moving to Postgres/Supabase").
DATABASE_URL="file:./dev.db"

# Claude API — used for match scoring, tailoring, and follow-up drafts.
# Without this set, the app falls back to deterministic mock output so the
# UI and workflows are still fully explorable offline.
ANTHROPIC_API_KEY=

# Notifications (Phase 3 — not required for local dev)
RESEND_API_KEY=
WHATSAPP_CLOUD_TOKEN=

# Billing (Phase 6 — not required for local dev)
STRIPE_SECRET_KEY=

# Express API Backend (Milestone 1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
